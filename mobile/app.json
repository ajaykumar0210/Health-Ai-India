{
  "expo": {
    "name": "Health AI India",
    "slug": "health-ai-india",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "healthaiindia",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.healthaiindia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d74795b9-ed28-43e9-ab6a-54fc07720ed3"
      }
    }
  }
}
